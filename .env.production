# Production build (npm run build): the browser loads content straight from WordPress.
VITE_WP_URL=https://wp.upperlatives.com
VITE_WP_DIRECT=true

# Keep the site out of search engines while it is being built (noindex meta tag +
# X-Robots-Tag header on every URL). Remove this line, or set it to false, to go public.
VITE_NOINDEX=true
