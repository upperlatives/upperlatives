# Copy to .env.local to override the defaults in .env on your machine.

# WordPress install that serves the content (REST API at <url>/wp-json).
#   remote: https://wp.upperlatives.com   local: https://upper.test
VITE_WP_URL=https://wp.upperlatives.com

# "true" = the browser calls WordPress directly (set in .env.production).
# Empty = requests go through the Vite dev-server proxy.
VITE_WP_DIRECT=
