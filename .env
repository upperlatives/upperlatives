# Defaults for every mode. Override per machine in .env.local (not committed).

# WordPress install that serves the content (REST API at <url>/wp-json).
VITE_WP_URL=https://wp.upperlatives.com

# "true" = the browser calls WordPress directly. Empty = requests go through the
# Vite dev-server proxy (development only).
VITE_WP_DIRECT=
